# Application origin for CORS / CSRF
APP_ORIGIN=

# Server configuration
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Supabase / PostgreSQL database configuration
# Use your Supabase connection string (Direct port 5432 or Pooler port 6543):
# e.g. postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_DATABASE_URL=
POSTGRES_URL=

# Embedded PostgreSQL fallback path when DATABASE_URL is not set
DATABASE_PATH=.data/afriscope

# Default Admin credentials
ADMIN_USERNAME=declareola
ADMIN_PASSWORD=afriscope2026*

# Demo workspace mode (true by default)
DEMO_ENABLED=true

# External LLM configuration
LLM_EXTERNAL_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
GEMINI_API_KEY=