# Local persistent PostgreSQL (PGlite) is the default; no credentials required.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=.data/afriscope
# Optional PostgreSQL connection. Keep private; use TLS in production.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Comma-separated exact browser origins. Required for unsafe requests in production.
APP_ORIGIN=http://localhost:3000
DEMO_ENABLED=true
# Optional server-only OpenAI-compatible provider. Never prefix secrets with VITE_.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# Allow external calls only after privacy review; synthetic approved aggregates only.
LLM_EXTERNAL_ENABLED=false
# Bootstrap a private organisation from the CLI, not a public administrator account.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
