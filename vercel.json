{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "supabase/migrations/**,public/demo/**"
    },
    "api/auth/auto.ts": {
      "maxDuration": 60,
      "includeFiles": "supabase/migrations/**,public/demo/**"
    },
    "api/auth/demo.ts": {
      "maxDuration": 60,
      "includeFiles": "supabase/migrations/**,public/demo/**"
    },
    "api/realtime/stream.ts": {
      "maxDuration": 60,
      "includeFiles": "supabase/migrations/**,public/demo/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|demo/|favicon.svg).*)",
      "destination": "/index.html"
    }
  ]
}
